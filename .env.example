# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/autoagent.log

# Groq API (primary LLM)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google AI Studio fallback-1 LLM API Key
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter fallback-2 LLM API Key 
OPENROUTER_API_KEY=your_openrouter_api_key_here

# PostgreSQL + pgvector
POSTGRES_USER=autoagent
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=autoagent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Backend
BACKEND_URL=http://localhost:8000

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Database URL (Prisma — used by frontend)
DATABASE_URL="postgresql://autoagent:your_password@localhost:5432/autoagent_db?schema=public"
